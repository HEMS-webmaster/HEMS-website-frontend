# HEMS Workshop Web Platform — Environment Variables Reference
# The frontend Next.js app reads from `src/frontend/.env.local`

# Copy this file to `src/frontend/.env.local`:
# cp .env.example src/frontend/.env.local

# Firebase Project Configuration (Required for Auth & Role Portals)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hems-workshop.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hems-workshop
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=hems-workshop.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Algolia Full-Text Indexing (Optional — falls back to offline JSON mock index)
NEXT_PUBLIC_ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_ADMIN_KEY=your_algolia_admin_key
