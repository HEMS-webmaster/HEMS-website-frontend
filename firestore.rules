rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify trusted email ownership (verified email or trusted OAuth provider)
    function hasVerifiedAuthEmail() {
      return request.auth != null
        && request.auth.token.email != null
        && (
          request.auth.token.email_verified == true
          || request.auth.token.firebase.sign_in_provider == 'google.com'
          || request.auth.token.firebase.sign_in_provider == 'microsoft.com'
        );
    }

    // Helper function to fetch user roles array safely from users/{userId} (unverified callers get [])
    function getUserRoles(userId) {
      return (request.auth != null && userId == request.auth.uid && !hasVerifiedAuthEmail())
        ? []
        : (exists(/databases/$(database)/documents/users/$(userId))
            ? get(/databases/$(database)/documents/users/$(userId)).data.get('roles', [])
            : []);
    }

    // Helper function to also check whitelist/{email} roles so verified whitelisted officers work immediately
    function getWhitelistRoles() {
      return (hasVerifiedAuthEmail()
              && exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower())))
        ? get(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower())).data.get('roles', [])
        : [];
    }

    // Helper function checking stored admin role arrays on users/{uid} and whitelist/{email}
    function hasStoredAdminRole(userId) {
      let uRoles = getUserRoles(userId);
      let wRoles = getWhitelistRoles();
      return 'admin' in uRoles
        || 'Admin' in uRoles
        || 'administration' in uRoles
        || 'Administration' in uRoles
        || 'administrator' in uRoles
        || 'Administrator' in uRoles
        || 'admin' in wRoles
        || 'Admin' in wRoles
        || 'administration' in wRoles
        || 'Administration' in wRoles
        || 'administrator' in wRoles
        || 'Administrator' in wRoles;
    }

    // Helper function to check if the user is an admin (protected webmaster short-circuits before Firestore get() calls)
    function isAdmin(userId) {
      return (hasVerifiedAuthEmail()
              && request.auth.token.email.lower() == 'webmaster@hems-workshop.org')
        || hasStoredAdminRole(userId);
    }

    // Strict Board role check (Board Portal & Board Repository access)
    function isBoard(userId) {
      let uRoles = getUserRoles(userId);
      let wRoles = getWhitelistRoles();
      return 'board' in uRoles
        || 'Board' in uRoles
        || 'board_member' in uRoles
        || 'board member' in uRoles
        || 'board members' in uRoles
        || 'Board Member' in uRoles
        || 'Board Members' in uRoles
        || 'board' in wRoles
        || 'Board' in wRoles
        || 'board_member' in wRoles
        || 'board member' in wRoles
        || 'board members' in wRoles
        || 'Board Member' in wRoles
        || 'Board Members' in wRoles;
    }

    // Helper function to check if the user has any Board Member or Admin role
    function isBoardOrAdmin(userId) {
      return isAdmin(userId) || isBoard(userId);
    }

    // Strict Operations role check (Operations Portal exclusive access)
    function isOperations(userId) {
      let uRoles = getUserRoles(userId);
      let wRoles = getWhitelistRoles();
      return 'operations' in uRoles
        || 'Operations' in uRoles
        || 'operations officer' in uRoles
        || 'Operations Officer' in uRoles
        || 'workshop operations' in uRoles
        || 'logistics' in uRoles
        || 'operations' in wRoles
        || 'Operations' in wRoles
        || 'operations officer' in wRoles
        || 'Operations Officer' in wRoles
        || 'workshop operations' in wRoles
        || 'logistics' in wRoles;
    }

    // Strict Treasurer role check (Treasurer Portal exclusive access)
    function isTreasurer(userId) {
      let uRoles = getUserRoles(userId);
      let wRoles = getWhitelistRoles();
      return 'treasurer' in uRoles
        || 'Treasurer' in uRoles
        || 'society treasurer' in uRoles
        || 'Society Treasurer' in uRoles
        || 'finance' in uRoles
        || 'financial officer' in uRoles
        || 'treasurer' in wRoles
        || 'Treasurer' in wRoles
        || 'society treasurer' in wRoles
        || 'Society Treasurer' in wRoles
        || 'finance' in wRoles
        || 'financial officer' in wRoles;
    }

    // Helper function to check if the user has Reviewer, Board, or Admin roles
    function isReviewerOrAdmin(userId) {
      let uRoles = getUserRoles(userId);
      let wRoles = getWhitelistRoles();
      return isBoardOrAdmin(userId)
        || 'reviewer' in uRoles
        || 'Reviewer' in uRoles
        || 'abstract reviewer' in uRoles
        || 'Abstract Reviewer' in uRoles
        || 'reviewers' in uRoles
        || 'Reviewers' in uRoles
        || 'reviewer' in wRoles
        || 'Reviewer' in wRoles
        || 'abstract reviewer' in wRoles
        || 'Abstract Reviewer' in wRoles
        || 'reviewers' in wRoles
        || 'Reviewers' in wRoles;
    }

    // Helper function to check if the user has Attendee or Admin roles
    function isAttendee(userId) {
      let uRoles = getUserRoles(userId);
      let wRoles = getWhitelistRoles();
      return isAdmin(userId)
        || 'attendee' in uRoles
        || 'Attendee' in uRoles
        || 'registered attendee' in uRoles
        || 'Registered Attendee' in uRoles
        || 'attendees' in uRoles
        || 'Attendees' in uRoles
        || 'attendee' in wRoles
        || 'Attendee' in wRoles
        || 'registered attendee' in wRoles
        || 'Registered Attendee' in wRoles
        || 'attendees' in wRoles
        || 'Attendees' in wRoles;
    }

    // User profiles rules
    match /users/{userId} {
      // Authenticated users can read their own profile; board & admins can read/list profiles for analytics
      allow get: if request.auth != null && (request.auth.uid == userId || isBoardOrAdmin(request.auth.uid));
      allow list: if request.auth != null && isBoardOrAdmin(request.auth.uid);
      
      // Users can create their own profile bound strictly to their Auth token email;
      // privileged roles require a verified email/OAuth identity matching whitelist/{token.email}
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email != null
        && request.resource.data.email is string
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && (
          request.resource.data.roles == ['general']
          || (
            hasVerifiedAuthEmail()
            && (
              (exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower()))
               && request.resource.data.roles == get(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower())).data.roles)
              || (request.auth.token.email.lower() == 'webmaster@hems-workshop.org'
                  && request.resource.data.roles == ['admin'])
            )
          )
        );
      
      // Users can update their own name/telemetry fields, cannot mutate email or self-promote roles.
      // Admins can update any user profile. Non-admins remain subject to daily download limits (max 30/day).
      allow update: if request.auth != null && (
        isAdmin(request.auth.uid) ||
        (
          request.auth.uid == userId
          && (
            (!('email' in resource.data) && (!('email' in request.resource.data) || (request.auth.token.email != null && request.resource.data.email is string && request.resource.data.email.lower() == request.auth.token.email.lower())))
            || ('email' in resource.data && resource.data.email is string && request.resource.data.email is string && request.resource.data.email.lower() == resource.data.email.lower())
          )
          && (
            request.resource.data.roles == resource.data.roles
            || (
              hasVerifiedAuthEmail()
              && exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower()))
              && request.resource.data.roles == get(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower())).data.roles
            )
          )
          && (
            !('downloadsToday' in request.resource.data) ||
            (
              request.resource.data.downloadsToday <= 30 &&
              (
                !('lastDownloadDate' in resource.data) ||
                request.resource.data.lastDownloadDate != resource.data.lastDownloadDate ||
                request.resource.data.downloadsToday == resource.data.get('downloadsToday', 0) + 1
              )
            )
          )
        )
      );
      
      // Only admins can delete profiles
      allow delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Reviewer-only documents (grading sheets, review comments)
    match /reviews/{document} {
      allow read, write: if request.auth != null && isReviewerOrAdmin(request.auth.uid);
    }

    // Attendee in-progress abstract drafts (owner-only multi-draft storage & sync)
    match /abstract_drafts/{draftId} {
      allow get: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid || isAdmin(request.auth.uid));
      allow list: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin(request.auth.uid));
      allow create: if request.auth != null
        && (request.resource.data.uid == request.auth.uid || isAdmin(request.auth.uid))
        && request.resource.data.uid is string
        && request.resource.data.updatedAt is string;
      allow update: if request.auth != null
        && ((resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid) || isAdmin(request.auth.uid))
        && request.resource.data.updatedAt is string;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin(request.auth.uid));
    }

    // Submitted workshop abstracts (attendee owner create/read/edit/withdraw up to deadline; reviewer/admin evaluate; operations presenter cross-check)
    match /abstract_submissions/{submissionId} {
      allow get: if request.auth != null && (
        resource == null
        || resource.data.submittedByUid == request.auth.uid
        || (hasVerifiedAuthEmail() && resource.data.get('submittedByEmail', '').lower() == request.auth.token.email.lower())
        || isReviewerOrAdmin(request.auth.uid)
        || isOperations(request.auth.uid)
      );
      allow list: if request.auth != null && (resource.data.submittedByUid == request.auth.uid || isReviewerOrAdmin(request.auth.uid) || isOperations(request.auth.uid));
      allow create: if request.auth != null
        && (isAttendee(request.auth.uid) || isReviewerOrAdmin(request.auth.uid))
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.status == 'Pending'
        && request.resource.data.decision == 'Pending'
        && !('score' in request.resource.data);
      allow update: if request.auth != null && (
        isReviewerOrAdmin(request.auth.uid)
        || (
          resource.data.submittedByUid == request.auth.uid
          && request.resource.data.submittedByUid == request.auth.uid
          && (
            (
              request.resource.data.get('status', 'Pending') == resource.data.get('status', 'Pending')
              && request.resource.data.get('decision', 'Pending') == resource.data.get('decision', 'Pending')
              && request.resource.data.get('score', null) == resource.data.get('score', null)
            )
            || (
              request.resource.data.status == 'Pending'
              && request.resource.data.decision == 'Pending'
              && !('score' in request.resource.data)
            )
          )
        )
      );
      allow delete: if request.auth != null && (resource.data.submittedByUid == request.auth.uid || isAdmin(request.auth.uid));
    }

    // Board-only documents (meeting minutes, annual budgets, governance records; 10 MB max per file)
    match /board_documents/{document} {
      allow read, delete: if request.auth != null && isBoard(request.auth.uid);
      allow create, update: if request.auth != null
        && isBoard(request.auth.uid)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 240
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() >= 1
        && request.resource.data.fileName.size() <= 240
        && request.resource.data.fileSizeBytes is int
        && request.resource.data.fileSizeBytes > 0
        && request.resource.data.fileSizeBytes <= 10485760
        && request.resource.data.status in ['active', 'archived'];
    }

    // Chunked binary fallback for Board-only documents (<= 600 KB raw slices / <= 920 KB base64 per chunk)
    match /board_document_blobs/{chunkId} {
      allow read, delete: if request.auth != null && isBoard(request.auth.uid);
      allow create, update: if request.auth != null
        && isBoard(request.auth.uid)
        && request.resource.data.docId is string
        && request.resource.data.chunkIndex is int
        && request.resource.data.chunkIndex >= 0
        && request.resource.data.chunkIndex < 20
        && request.resource.data.base64Data is string
        && request.resource.data.base64Data.size() <= 920000;
    }

    // Mailing list subscriber directory (Strict Operations role access; public flows go via Cloud Functions / write-only queue)
    match /mailing_subscribers/{subscriberId} {
      allow read, write: if request.auth != null && isOperations(request.auth.uid);
    }

    // Mailing list campaign & broadcast audit log (Strict Operations role access)
    match /mailing_campaigns/{campaignId} {
      allow read, write: if request.auth != null && isOperations(request.auth.uid);
    }

    // Write-only public signup / unsubscribe / contact inquiry queue (unreadable publicly; reviewed by Operations)
    match /mailing_public_requests/{requestId} {
      allow read, update, delete: if request.auth != null && isOperations(request.auth.uid);
      allow create: if request.resource.data.keys().hasOnly([
          'type', 'email', 'newEmail', 'firstName', 'lastName',
          'affiliation', 'interests', 'token', 'subject', 'message',
          'recipientEmail', 'createdAt', 'status'
        ])
        && request.resource.data.type in ['subscribe', 'unsubscribe', 'update_email', 'contact_inquiry']
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && (!('newEmail' in request.resource.data) || (request.resource.data.newEmail is string && request.resource.data.newEmail.size() <= 254))
        && (!('firstName' in request.resource.data) || (request.resource.data.firstName is string && request.resource.data.firstName.size() <= 100))
        && (!('lastName' in request.resource.data) || (request.resource.data.lastName is string && request.resource.data.lastName.size() <= 100))
        && (!('affiliation' in request.resource.data) || (request.resource.data.affiliation is string && request.resource.data.affiliation.size() <= 180))
        && (!('interests' in request.resource.data) || (request.resource.data.interests is list && request.resource.data.interests.size() <= 10))
        && (!('token' in request.resource.data) || (request.resource.data.token is string && request.resource.data.token.size() <= 128))
        && (!('subject' in request.resource.data) || (request.resource.data.subject is string && request.resource.data.subject.size() <= 200))
        && (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 5000))
        && (!('recipientEmail' in request.resource.data) || (request.resource.data.recipientEmail is string && request.resource.data.recipientEmail.size() <= 254))
        && (!('createdAt' in request.resource.data) || (request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40))
        && (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'forwarded']);
    }

    // Whitelist management (Admins manage full list; verified authenticated users may read only their own email entry; webmaster@hems-workshop.org permanently retains admin)
    match /whitelist/{document} {
      allow get: if request.auth != null && (
        isAdmin(request.auth.uid) ||
        (hasVerifiedAuthEmail() && request.auth.token.email.lower() == document)
      );
      allow list: if request.auth != null && isAdmin(request.auth.uid);
      allow create, update: if request.auth != null
        && isAdmin(request.auth.uid)
        && (
          document != 'webmaster@hems-workshop.org'
          || 'admin' in request.resource.data.get('roles', [])
          || 'administration' in request.resource.data.get('roles', [])
        );
      allow delete: if request.auth != null
        && isAdmin(request.auth.uid)
        && document != 'webmaster@hems-workshop.org';
    }

    // Document download counters (Board & Admin read access; verified users may only increment by +1 with bounded fields)
    match /downloads/{document} {
      allow read: if request.auth != null && isBoardOrAdmin(request.auth.uid);
      allow create: if hasVerifiedAuthEmail()
        && request.resource.data.keys().hasOnly([
          'fileName', 'downloadCount', 'lastDownloaded', 'category', 'workshopName'
        ])
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() >= 1
        && request.resource.data.fileName.size() <= 260
        && request.resource.data.downloadCount == 1
        && request.resource.data.lastDownloaded is string
        && request.resource.data.lastDownloaded.size() <= 40
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 60
        && request.resource.data.workshopName is string
        && request.resource.data.workshopName.size() <= 40;
      allow update: if hasVerifiedAuthEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fileName', 'downloadCount', 'lastDownloaded', 'category', 'workshopName'
        ])
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() >= 1
        && request.resource.data.fileName.size() <= 260
        && request.resource.data.downloadCount == resource.data.get('downloadCount', 0) + 1
        && request.resource.data.lastDownloaded is string
        && request.resource.data.lastDownloaded.size() <= 40
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 60
        && request.resource.data.workshopName is string
        && request.resource.data.workshopName.size() <= 40;
    }

    // First-party website & campaign telemetry rollups (written by Cloud Functions; read by Board & Admin)
    match /telemetry_daily/{dayId} {
      allow read: if request.auth != null && isBoardOrAdmin(request.auth.uid);
    }

    match /telemetry_campaigns/{campaignSlug} {
      allow read: if request.auth != null && isBoardOrAdmin(request.auth.uid);
    }

    // First-party telemetry event stream (Board & Admin read; schema-validated write-only fallback for pre-cutover/local)
    match /telemetry_events/{eventId} {
      allow read, delete: if request.auth != null && isBoardOrAdmin(request.auth.uid);
      allow create: if request.resource.data.keys().hasOnly([
          'eventType', 'path', 'pageTitle', 'sessionId', 'campaignSlug',
          'referrerCategory', 'referrerHost', 'deviceType', 'country',
          'region', 'targetLabel', 'userUid', 'userEmail', 'userName',
          'dateKey', 'timestamp', 'rolledUp'
        ])
        && request.resource.data.eventType in [
          'page_view', 'mailto_click', 'outbound_click', 'mailing_signup', 'pdf_download', 'contact_inquiry'
        ]
        && request.resource.data.path is string
        && request.resource.data.path.size() >= 1
        && request.resource.data.path.size() <= 180
        && request.resource.data.pageTitle is string
        && request.resource.data.pageTitle.size() <= 160
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() <= 80
        && request.resource.data.campaignSlug is string
        && request.resource.data.campaignSlug.size() <= 100
        && request.resource.data.referrerCategory is string
        && request.resource.data.referrerCategory.size() <= 64
        && request.resource.data.referrerHost is string
        && request.resource.data.referrerHost.size() <= 120
        && request.resource.data.deviceType in ['Desktop', 'Mobile', 'Tablet']
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 40
        && request.resource.data.region is string
        && request.resource.data.region.size() <= 60
        && request.resource.data.targetLabel is string
        && request.resource.data.targetLabel.size() <= 180
        && request.resource.data.userUid is string
        && request.resource.data.userUid.size() <= 100
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail.size() <= 180
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 120
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.size() == 10
        && request.resource.data.timestamp is string
        && request.resource.data.timestamp.size() >= 10
        && request.resource.data.timestamp.size() <= 40
        && request.resource.data.rolledUp == false;
    }

    // Workshop registration ledger (written exclusively via Cloud Functions Admin SDK)
    match /workshop_registrations/{regId} {
      allow get, list: if request.auth != null && (
        isOperations(request.auth.uid)
        || isTreasurer(request.auth.uid)
        || (hasVerifiedAuthEmail()
            && resource.data.email == request.auth.token.email.lower())
      );
      allow write: if false;
    }

    // Workshop promo, sponsor-seat, and student-awardee waiver codes (managed via Admin SDK)
    match /workshop_promo_codes/{code} {
      allow read: if request.auth != null && (isOperations(request.auth.uid) || isTreasurer(request.auth.uid));
      allow write: if false;
    }

    // Atomic sequential receipt & invoice counters (server-only)
    match /workshop_counters/{docId} {
      allow read, write: if false;
    }

    // Privacy-preserving hashed IP/subject rate-limit buckets (Admin SDK only)
    match /rate_limits/{bucketId} {
      allow read, write: if false;
    }

    // Automated cloud budget & archive circuit-breaker telemetry (Board & Admin read; Admin SDK write)
    match /system_alerts/{alertId} {
      allow read: if request.auth != null && isBoardOrAdmin(request.auth.uid);
      allow write: if false;
    }

    // Workshop Configuration Control Center: Public Live Config, Private Admin Draft,
    // Zero-Login Shareable Board Previews, and Kernel-Immutable Append-Only Version History
    match /site_config/{docId} {
      allow get: if docId == 'workshop_live'
        || (request.auth != null && isAdmin(request.auth.uid));
      allow list: if request.auth != null && isAdmin(request.auth.uid);
      allow create, update: if request.auth != null
        && isAdmin(request.auth.uid)
        && docId in ['workshop_live', 'workshop_draft']
        && request.resource.data.config is map
        && request.resource.data.updatedAt is string;
      allow delete: if request.auth != null
        && isAdmin(request.auth.uid)
        && docId == 'workshop_draft';
    }

    match /site_config_previews/{previewToken} {
      allow get: if true;
      allow list: if request.auth != null && isAdmin(request.auth.uid);
      allow create, update, delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    match /site_config_history/{versionId} {
      allow read: if request.auth != null && isAdmin(request.auth.uid);
      allow create: if request.auth != null
        && isAdmin(request.auth.uid)
        && request.resource.data.versionNumber is int
        && request.resource.data.createdAt is string
        && request.resource.data.createdByEmail is string
        && request.resource.data.config is map;
      allow update, delete: if false;
    }
  }
}
