rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to fetch user roles array from the users collection
    function getUserRoles(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.roles;
    }

    // Helper function to check if the user is an admin
    function isAdmin(userId) {
      return 'admin' in getUserRoles(userId);
    }

    // User profiles rules
    match /users/{userId} {
      // Authenticated users can read their own profile, admins can read all profiles
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin(request.auth.uid));
      allow list: if request.auth != null && isAdmin(request.auth.uid);
      
      // Users can create their own profile, defaulting strictly to ['general'] or matching their whitelist roles
      allow create: if request.auth != null && request.auth.uid == userId && (
        request.resource.data.roles == ['general'] || 
        (exists(/databases/$(database)/documents/whitelist/$(request.resource.data.email.lower())) &&
         request.resource.data.roles == get(/databases/$(database)/documents/whitelist/$(request.resource.data.email.lower())).data.roles)
      );
      
      // Users can update their name/email but cannot self-promote their roles. Admins can update any user roles.
      // Non-admins are subject to daily download limits (max 30/day) if modifying tracking fields.
      allow update: if request.auth != null && (
        isAdmin(request.auth.uid) || 
        (
          request.auth.uid == userId && 
          request.resource.data.roles == resource.data.roles &&
          (
            !('downloadsToday' in request.resource.data) ||
            (
              request.resource.data.downloadsToday <= 30 &&
              (
                !('lastDownloadDate' in resource.data) ||
                request.resource.data.lastDownloadDate != resource.data.lastDownloadDate ||
                request.resource.data.downloadsToday == resource.data.get('downloadsToday', 0) + 1
              )
            )
          )
        )
      );
      
      // Only admins can delete profiles
      allow delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Reviewer-only documents (grading sheets, review comments)
    match /reviews/{document} {
      allow read, write: if request.auth != null && ('reviewer' in getUserRoles(request.auth.uid) || isAdmin(request.auth.uid));
    }

    // Board-only documents (meeting minutes, annual budgets)
    match /board_documents/{document} {
      allow read, write: if request.auth != null && ('board' in getUserRoles(request.auth.uid) || isAdmin(request.auth.uid));
    }

    // Whitelist management
    match /whitelist/{document} {
      allow read, write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Document download counters
    match /downloads/{document} {
      allow read: if request.auth != null && isAdmin(request.auth.uid);
      allow create, update: if request.auth != null;
    }
  }
}
