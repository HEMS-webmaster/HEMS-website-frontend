{
  "hosting": {
    "public": "src/frontend/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/mailing/subscribe",
        "function": {
          "functionId": "mailingSubscribe",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/mailing/confirm",
        "function": {
          "functionId": "mailingConfirm",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/mailing/unsubscribe",
        "function": {
          "functionId": "mailingUnsubscribe",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/mailing/one-click-unsubscribe",
        "function": {
          "functionId": "mailingUnsubscribe",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/mailing/webhooks/postmark",
        "function": {
          "functionId": "mailingWebhookPostmark",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/mailing/send-campaign",
        "function": {
          "functionId": "mailingSendCampaign",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/telemetry/event",
        "function": {
          "functionId": "telemetryEvent",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/404.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
