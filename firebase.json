{
  "hosting": {
    "public": "src/frontend/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "regex": "(?i)^/(?:15thws/)?15thcorp_sponsors\\.html?$",
        "destination": "/corporate-sponsorship/",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:15thws/)?15thstudenttravel\\.html?$",
        "destination": "/student-awards/",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:aboutus|about_us|about-us|about)\\.html?$",
        "destination": "/about/",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:history|pastworkshops|past_workshops)\\.html?$",
        "destination": "/history/",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:archives?|proceedings)\\.html?$",
        "destination": "/archive/",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:contact|contactus|contact_us|contact-us)\\.html?$",
        "destination": "/contact/",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:sponsors|sponsorship|corporate_sponsors)\\.html?$",
        "destination": "/corporate-sponsorship/",
        "type": 301
      },
      {
        "regex": "(?i)^/(?:student_?awards|studenttravel|travel_?awards)\\.html?$",
        "destination": "/student-awards/",
        "type": 301
      },
      {
        "regex": "(?i)^/logos/hemslogo3?\\.(?:jpg|jpeg|png|gif)$",
        "destination": "/hemslogo.jpg",
        "type": 301
      },
      {
        "regex": "(?i)^/1stws(?:/.*)?$",
        "destination": "/archive/1999/",
        "type": 301
      },
      {
        "regex": "(?i)^/2ndws(?:/.*)?$",
        "destination": "/archive/2001/",
        "type": 301
      },
      {
        "regex": "(?i)^/3rdws(?:/.*)?$",
        "destination": "/archive/2002/",
        "type": 301
      },
      {
        "regex": "(?i)^/4thws(?:/.*)?$",
        "destination": "/archive/2003/",
        "type": 301
      },
      {
        "regex": "(?i)^/5thws(?:/.*)?$",
        "destination": "/archive/2005/",
        "type": 301
      },
      {
        "regex": "(?i)^/6thws(?:/.*)?$",
        "destination": "/archive/2007/",
        "type": 301
      },
      {
        "regex": "(?i)^/7thws(?:/.*)?$",
        "destination": "/archive/2009/",
        "type": 301
      },
      {
        "regex": "(?i)^/8thws(?:/.*)?$",
        "destination": "/archive/2011/",
        "type": 301
      },
      {
        "regex": "(?i)^/9thws(?:/.*)?$",
        "destination": "/archive/2013/",
        "type": 301
      },
      {
        "regex": "(?i)^/10thws(?:/.*)?$",
        "destination": "/archive/2015/",
        "type": 301
      },
      {
        "regex": "(?i)^/11thws(?:/.*)?$",
        "destination": "/archive/2017/",
        "type": 301
      },
      {
        "regex": "(?i)^/12thws(?:_eurohems)?(?:/.*)?$",
        "destination": "/archive/2018/",
        "type": 301
      },
      {
        "regex": "(?i)^/13thws(?:/.*)?$",
        "destination": "/archive/2019/",
        "type": 301
      },
      {
        "regex": "(?i)^/14thws(?:/.*)?$",
        "destination": "/archive/2022/",
        "type": 301
      },
      {
        "regex": "(?i)^/15thws(?:/.*)?$",
        "destination": "/archive/2025/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/mailing/subscribe",
        "function": {
          "functionId": "mailingSubscribe",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/mailing/confirm",
        "function": {
          "functionId": "mailingConfirm",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/mailing/unsubscribe",
        "function": {
          "functionId": "mailingUnsubscribe",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/mailing/one-click-unsubscribe",
        "function": {
          "functionId": "mailingUnsubscribe",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/mailing/webhooks/postmark",
        "function": {
          "functionId": "mailingWebhookPostmark",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/mailing/send-campaign",
        "function": {
          "functionId": "mailingSendCampaign",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/telemetry/event",
        "function": {
          "functionId": "telemetryEvent",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/contact/inquiry",
        "function": {
          "functionId": "contactInquiry",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/registration/create-session",
        "function": {
          "functionId": "registrationCreateSession",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/registration/webhooks/stripe",
        "function": {
          "functionId": "registrationWebhookStripe",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/registration/receipt",
        "function": {
          "functionId": "registrationGetReceipt",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/registration/admin-action",
        "function": {
          "functionId": "registrationAdminAction",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/404.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
