# HEMS Workshop Web Platform — Environment Variables Template
# Canonical location: copy this file to `src/frontend/.env.local`
# Cloud owner account: webmaster@hems-workshop.org (Firebase project: hems-workshop)

# 1. Firebase Web Client Configuration (Portal Auth & Preview Hosting)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hems-workshop.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hems-workshop
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=hems-workshop.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=996590178042
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-F06RZ8L5CR

# 2. Upcoming Workshop Google Sheet CSV Feed ($0 Google Nonprofits Tier)
# Optional build/dev override — can also be stored directly in `src/data/upcoming_workshop.json` ("sheet_csv_url")
NEXT_PUBLIC_WORKSHOP_SHEET_CSV_URL=

# 3. Optional Algolia PDF Sync (`scripts/index-pdf-contents.js` — leave blank to use bundled Fuse.js JSON index)
# NEXT_PUBLIC_ALGOLIA_APP_ID=
# ALGOLIA_ADMIN_KEY=
