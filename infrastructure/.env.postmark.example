# Postmark & HEMS Mailing Configuration Template (Copy to functions/.env when going live)
HEMS_SITE_ORIGIN=https://hems-workshop.org
POSTMARK_SERVER_TOKEN=
POSTMARK_TRANSACTIONAL_STREAM=outbound
POSTMARK_BROADCAST_STREAM=broadcast
POSTMARK_FROM_TRANSACTIONAL="HEMS Society <announcements@mail.hems-workshop.org>"
POSTMARK_FROM_BROADCAST="HEMS Workshop Organizing Committee <announcements@mail.hems-workshop.org>"
POSTMARK_REPLY_TO=president@hems-workshop.org
POSTMARK_WEBHOOK_SECRET=
HEMS_POSTAL_FOOTER="Harsh-Environment Mass Spectrometry Society, Inc. (501(c)(3) Scientific Organization) • St. Petersburg, FL, USA"

