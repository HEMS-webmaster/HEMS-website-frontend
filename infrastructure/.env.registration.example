# ==============================================================================
# HEMS Workshop Registration & Auto-Advance Environment Configuration (Template)
# ==============================================================================
# Never commit real secret values to git. Set production secrets via:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# ==============================================================================

# 1. Stripe Hosted Checkout & Webhook Secrets (Card + US Bank Account ACH)
# Use sk_test_... / whsec_... for Sandbox Testing, then sk_live_... before launch
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional frontend display hint ("live" | "test") for Treasurer Portal Dashboard deep-links:
NEXT_PUBLIC_STRIPE_DASHBOARD_MODE=live

# 2. Society IRS 501(c)(3) Tax & Invoice Remittance Details
# Public frontend optional display variable (never invent or commit placeholder EINs):
NEXT_PUBLIC_HEMS_SOCIETY_EIN=
HEMS_SOCIETY_EIN=
HEMS_INVOICE_REMIT_ADDRESS=Harsh-Environment Mass Spectrometry Society, Inc. • St. Petersburg, FL, USA

# 3. Google Workspace for Nonprofits — Live Registration Spreadsheet Sync ($0/mo)
# Share the target Google Sheet with Editor access to your Firebase Admin Service Account email
GOOGLE_REGISTRATION_SHEET_ID=
GOOGLE_REGISTRATION_SHEET_TAB=2027 Registrations

# 4. Workshop Config Google Sheet CSV URL (Already bundled default)
WORKSHOP_SHEET_CSV_URL=

# ==============================================================================
# GOOGLE SHEET AUTO-ADVANCE `field_key` REFERENCE
# ==============================================================================
# field_key                       | Example Value              | Behavior
# --------------------------------|----------------------------|------------------------------------------
# reg_opening_date                | March 1, 2027              | Hidden/disabled before 00:00 in reg_timezone; auto-opens on date
# reg_early_bird_closes           | July 15, 2027              | Early-bird fees active through 23:59:59; auto-advances to Regular after
# conference_start_date           | September 14, 2027         | First day of workshop
# conference_end_date             | September 17, 2027         | Final day of workshop; registration auto-closes after 23:59:59
# exact_dates                     | September 14–17, 2027      | Range-end automatically parsed if conference_end_date is TBA
# reg_timezone                    | EDT (UTC-04:00)            | Timezone for opening & close cutoffs
# reg_force_closed                | FALSE                      | Emergency manual pause override (TRUE disables form immediately)
# reg_student_early_fee           | $200                       | Early Student registration price
# reg_professional_early_fee      | $425                       | Early Regular registration price
# reg_sponsor_early_fee           | $1,350                     | Early Corporate Sponsor price
# reg_student_fee                 | $250                       | Standard Student price (after early_bird_closes)
# reg_professional_fee            | $500                       | Standard Regular price (after early_bird_closes)
# reg_sponsor_fee                 | $1,350                     | Standard Corporate Sponsor price
# reg_guest_dinner_fee            | $75                        | Spouse / Guest Wednesday Dinner add-on ticket price
# reg_enable_student_fund_donation| TRUE                       | Show optional tax-deductible Student Travel Award add-on
